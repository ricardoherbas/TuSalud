
# Backend
BACKEND_CONTAINER_NAME=tusalud_backend
BACKEND_PORT_HOST=3000
BACKEND_PORT_CONTAINER=3000
PORT=3000

# Frontend
NGINX_IMAGE=nginx:alpine
FRONTEND_CONTAINER_NAME=tusalud_frontend
FRONTEND_PORT_HOST=8080
FRONTEND_PORT_CONTAINER=80

# PostgreSQL
POSTGRES_IMAGE=postgres:16-alpine
DB_CONTAINER_NAME=tusalud_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tusalud
DB_USER=postgres
DB_PASSWORD=

# Conexión del backend dentro de Docker
DB_HOST_DOCKER=db
DB_PORT_CONTAINER=5432
DB_PORT_HOST=5432

# Autenticación
JWT_SECRET=

PGADMIN_CONTAINER_NAME=tusalud_pgadmin
PGADMIN_PORT_HOST=5050
PGADMIN_DEFAULT_EMAIL=admin@tusalud.local
PGADMIN_DEFAULT_PASSWORD=cambia_esta_clave
